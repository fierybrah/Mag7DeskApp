.DS_Store
.venv/
.env
.env.*
!.env.example
alpaca.env
__pycache__/
*.py[cod]
# Training-only diagnostics stay out of git (walk_forward_predictions.csv is
# ~14MB and metrics.json is regenerated by every training run). model.joblib
# and metadata.json ARE tracked: the Render cron job runs stateless and needs
# the already-trained model committed to score anything (see ml/README.md).
ml/artifacts/*
!ml/artifacts/model.joblib
!ml/artifacts/metadata.json
data/*.csv
# data/ml_predictions.json is intentionally tracked: server.js serves it at
# runtime and Render deploys from git, so it must ship with the repo.
